<?xml version="1.0"?>

<workflow-definition
	xmlns="urn:liferay.com:liferay-workflow_7.4.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:liferay.com:liferay-workflow_7.4.0 http://www.liferay.com/dtd/liferay-workflow-definition_7_4_0.xsd"
>
	<name>Medical Expert</name>
	<version>1</version>
	<llm>
		<name>medicalExpert</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						276,
						242
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Medical Expert
			</label>
		</labels>
		<input-variables>
			<![CDATA[
				[
					{
						"name": "request",
						"type": "string"
					}
				]
			]]>
		</input-variables>
		<output-variables>
			<![CDATA[
				[
					{
						"name": "answer",
						"type": "string"
					}
				]
			]]>
		</output-variables>
		<prompt>
			<![CDATA[You are a medical expert. Answer the request from a medical point of view in no more than 3 sentences, and recommend seeing a healthcare professional when the situation calls for it. Return only the answer and nothing else.]]>
		</prompt>
		<tools>
			<![CDATA[[]]]>
		</tools>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						End
					</label>
				</labels>
				<name>end</name>
				<target>end</target>
				<default>true</default>
			</transition>
		</transitions>
		<user-message>
			<![CDATA[The request is {{request}}.]]>
		</user-message>
	</llm>
	<state>
		<name>start</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						273,
						25
					]
				}
			]]>
		</metadata>
		<initial>true</initial>
		<labels>
			<label language-id="en_US">
				Start
			</label>
		</labels>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Medical Expert
					</label>
				</labels>
				<name>medicalExpert</name>
				<target>medicalExpert</target>
				<default>true</default>
			</transition>
		</transitions>
	</state>
	<state>
		<name>end</name>
		<metadata>
			<![CDATA[
				{
					"terminal": true,
					"xy": [
						277,
						459
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				End
			</label>
		</labels>
	</state>
</workflow-definition>